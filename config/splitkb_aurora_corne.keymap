#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/rgb.h>
#include "keymap_optimot.h"

#define L1  0
#define L4  1
#define L2  2
#define L3  3

&nice_view_spi {
    cs-gpios = <&pro_micro 0 GPIO_ACTIVE_HIGH>;
};



/*****************************************************************************/
                            /* Home Row Mods */
/*****************************************************************************/

/* Left hand key positions fo[sr use with right hand mods */
#define LEFT_HAND_KEYS \
    /*    ┌────┬────┬────┬────┬────┐                                       */ \
            0    1    2    3    4     5                                       \
    /*    ├────┼────┼────┼────┼────┼────┐                                  */ \
            12   13   14   15   16   17                                      \
    /*    ├────┼────┼────┼────┼────┼────┤                                  */ \
            24   25   26   27   28   29                                       \
    /*    ├────┼────┼────┼────┼────┼────┤                                  */ \
  

/* Right hand key positions for use with left hand mods */
#define RIGHT_HAND_KEYS \
    /*                                          ┌────┬────┬────┬────┬────┐ */ \
                                             6     7    8    9   10   11      \
    /*                                     ┌────┼────┼────┼────┼────┼────┤ */ \
                                             18   19   20   21   22   23      \
    /*                                     ├────┼────┼────┼────┼────┼────┤ */ \
                                             30   31   32   33   34   35      \
    /*                                     ├────┼────┼────┼────┼────┼────┤ */ \
    

/* Thumb key positions for use with mods on both hands */
#define THUMB_KEYS \
    /*                 ┌────┬────┬────┐      ┌────┬────┬────┐              */ \
                         36   37   38          39   40   41                   \
    /*                 ├────┼────┼────┤      ├────┼────┼────┤              */ \


/ {

 behaviors {
        ht: hold_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_TAP";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
        lh_hm: left_hand_homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "LEFT_HAND_HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <300>;
            quick-tap-ms = <150>;
            flavor = "balanced";
            hold-trigger-key-positions = <RIGHT_HAND_KEYS THUMB_KEYS>;
            hold-trigger-on-release;
            bindings = <&kp>, <&kp>;
        };  
        rh_hm: right_hand_homerow_mods {    
            compatible = "zmk,behavior-hold-tap";
            label = "RIGHT_HAND_HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <300>;
            quick-tap-ms = <150>;
            global-quick-tap;
            flavor = "balanced";
            hold-trigger-key-positions = <LEFT_HAND_KEYS THUMB_KEYS>;
            hold-trigger-on-release;
            bindings = <&kp>, <&kp>;
            
        };
        excumflex: excumflex {
            compatible = "zmk,behavior-mod-morph";
            label = "EXCUMFLEX";
            #binding-cells = <0>;
            bindings = <&kp OP_DCIR>, <&kp OP_EXLM>;
            mods = <(MOD_LSFT)>;
        };
        virgpts: virgpts {
            compatible = "zmk,behavior-mod-morph";
            label = "VIRGPTS";
            #binding-cells = <0>;
            bindings = <&kp OP_COMM>, <&kp OP_SCLN>;
            mods = <(MOD_LSFT)>;
        };
        points: points {
            compatible = "zmk,behavior-mod-morph";
            label = "POINTS";
            #binding-cells = <0>;
            bindings = <&kp OP_DOT>, <&kp OP_COLN>;
            mods = <(MOD_LSFT)>;
        };
        questionstrophe: questionstrophe {
            compatible = "zmk,behavior-mod-morph";
            label = "QUESTIONSTROPHE";
            #binding-cells = <0>;
            bindings = <&kp OP_QUOT>, <&kp OP_QUES>;
            mods = <(MOD_LSFT)>;
        };
    };

    macros {

        to_L1_from_L2: to_L1_from_L2 {
            label = "to_layer_L1_from_L2";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&tog L1>
                , <&tog L2>
                ;
        };

        to_L1_from_L3: to_L1_from_L3 {
            label = "to_layer_L1_from_L3";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&tog L1>
                , <&tog L3>
                ;
        };

        to_L1_from_L4: to_L1_from_L4 {
            label = "to_layer_L1_from_L4";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&tog L1>
                , <&tog L4>
                ;
        };

        to_L2_from_L3: to_L2_from_L3 {
            label = "to_layer_L2_from_L3";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&tog L3>
                , <&tog L2>
                ;
        };

        to_L3_from_L2: to_L3_from_L2 {
            label = "to_layer_L3_from_L2";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&tog L2>
                , <&tog L3>
                ;
        };

        to_L4_from_L3: to_L4_from_L3 {
            label = "to_layer_L4_from_L3";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&tog L4>
                , <&tog L3>
                ;
        };

         to_L3_from_L4: to_L3_from_L4 {
            label = "to_layer_L3_from_L4";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&tog L3>
                , <&tog L4>
                ;
        };

        to_L4_from_L2: to_L4_from_L2 {
            label = "to_layer_L4_from_L2";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&tog L4>
                , <&tog L2>
                ;
        };

         to_L2_from_L4: to_L2_from_L4 {
            label = "to_layer_L2_from_L4";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&tog L2>
                , <&tog L4>
                ;
        };

    };
    combos { 
        compatible = "zmk,combos";

        combo_cut_mac { // KY
            timeout-ms = <50>;
            key-positions = <25 26>;
            bindings = <&kp LG(X)>;
        };

        combo_copy_mac { // YÈ
            timeout-ms = <50>;
            key-positions = <26 27>;
            bindings = <&kp LG(C)>;
        };

        combo_paste_mac { // È‧
            timeout-ms = <50>;
            key-positions = <27 28>;
            bindings = <&kp LG(V)>;
        };

        combo_dash { // DL
            timeout-ms = <50>;
            key-positions = <7 8>;
            bindings = <&kp OP_MINS>;
        };

        combo_mo_symb { // TS
            timeout-ms = <30>;
            key-positions = <19 20>;
            bindings = <&mo L2>;
        };


        combo_mo_nav { // SR
            timeout-ms = <30>;
            key-positions = <20 21>;
            bindings = <&mo L3>;
        };

        combo_mo_num { // TR
            timeout-ms = <30>;
            key-positions = <19 21>;
            bindings = <&mo L4>;
        };

        combo_mo_symb_l { // TS
            timeout-ms = <30>;
            key-positions = <15 16>;
            bindings = <&mo L2>;
        };


        combo_mo_nav_l { // SR
            timeout-ms = <30>;
            key-positions = <14 15>;
            bindings = <&mo L3>;
        };

        combo_mo_num_l { // TR
            timeout-ms = <30>;
            key-positions = <14 16>;
            bindings = <&mo L4>;
        };

        combo_clear_bt { //àjo
            timeout-ms = <30>;
            key-positions = <1 2 3>;
            bindings = <&bt BT_CLR>;
        };

        combo_zmk_sudio { //qx
            timeout-ms = <30>;
            key-positions = <10 11>;
            bindings = <&studio_unlock>;
        };

        combo_cedille { // cm
            timeout-ms = <30>;
            key-positions = <31 32>;
            bindings = <&kp OP_CCED>;
        };

        combo_ugrave { // u,
            timeout-ms = <30>;
            key-positions = <16 17>;
            bindings = <&kp OP_UGRV>;
        };

        combo_oe { // oe
            timeout-ms = <30>;
            key-positions = <3 15>;
            bindings = <&kp LA(O)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";
        default_layer {
            label = "OPTIMOT";
        
            // -------------------------------------------------------------------------------
            // | TAB  |  à  |  J  |  O  |  é  |  B  |   |  F  |  D  |  L  |  ’? |  Q  |  X   |
            // | ESC  |  A  |  I  |  E  |  U  |  ,; |   |  P  |  T  |  S  |  R  |  N  |  ^!  |
            // | CTRL |  K  |  Y  |  è  |  .: |  W  |   |  G  |  C  |  M  |  H  |  V  |  Z   |
            //                  | WIN | SHIFT | SPC |   |BSPC |ENTER| L2 |
           
            
            bindings = <
                &kp TAB     &kp OP_AGRV    &kp OP_J  &kp OP_O        &kp OP_EACU    &kp OP_B           &kp OP_F       &kp OP_D    &kp OP_L       &questionstrophe  &kp OP_Q &kp OP_X
                &kp ESC     &kp OP_A       &kp OP_I  &kp OP_E        &kp OP_U       &virgpts        &kp OP_P       &kp OP_T     &kp OP_S       &kp OP_R             &kp OP_N    &excumflex
                &kp LCTRL   &kp OP_K       &kp OP_Y  &kp OP_EGRV  &points        &kp OP_W        &kp OP_G    &kp OP_C    &kp OP_M    &kp OP_H             &kp OP_V    &kp OP_Z
                                   &kp LWIN &kp LSHIFT &kp SPACE   &kp BSPC &kp ENTER &tog L2  
            >;
        };
           

        numpad_layer {
            label = "NUMPAD";
            // -----------------------------------------------------------------------------------------
            //    |    X  | BT_NXT |  X  |  X  |  X  | PRINTMAC|      |  *  |  7   |  8  |  9  |  +   |  BSPC   |
            //    |    X  |    X   |  X  |  X  |  X  | X       |      |  =  |  4   |  5  |  6  |  -   |  ENTER  |
            //    |    X  |    X   |  X  |  X  |  X  | OUT_TOG |      |  0  |  1   |  2  |  3  |  .   |   L3    |
            //                           |  L1 | ALT |     X   |      |  X  |  X   |  L2 |
            bindings = < 
               &trans    &bt BT_NXT   &trans        &trans       &trans       &kp LG(LS(N5))     &kp OP_ASTR  &kp OP_7 &kp OP_8 &kp OP_9 &kp OP_PLUS   &kp BSPC
               &trans    &trans       &trans        &trans       &trans       &trans             &kp OP_EQL   &kp OP_4 &kp OP_5 &kp OP_6 &kp OP_HMIN   &kp ENTER
               &trans    &trans       &trans        &trans       &trans       &out OUT_TOG       &kp OP_0     &kp OP_1 &kp OP_2 &kp OP_3 &kp OP_DOT    &to_L3_from_L4
                                                                          &to_L1_from_L4 &kp LALT &trans    &trans &trans &to_L2_from_L4
                        >;
                };

        symb_layer {
            label = "SYMBOLES";
            // --------------------------------------------------------------------------------------
            //    |  X  |  @  |  '  |  "  |  *  |   `   |   |  |  |  -   |  _  |  &  |  °  |  BSPC  |
            //    |  X  |  ~  |  <  |  >  |  =  |   $   |   |  \  |  {   |  }  |  /  |  ~  |    ¨   |
            //    |  X  |  €  |  #  |  %  |  +  |   ²   |   |  [  |  (   |  )  |  ]  |  ↑  |   L3   |
            //                       | L1 | ALT |   X   |   |  X  |  X   | L4 |
            bindings = < 
               &trans    &kp OP_AT    &kp OP_QUOT  &kp OP_DQUO    &kp OP_ASTR  &kp OP_GRV       &kp OP_PIPE  &kp OP_MINS &kp OP_UNDS &kp OP_AMPR &kp OP_DEG  &kp BSPC
               &trans    &kp OP_DTIL  &kp OP_LABK  &kp OP_RABK    &kp OP_EQL   &kp OP_DLR       &kp OP_BSLS  &kp OP_LCBR &kp OP_RCBR &kp OP_SLSH &kp OP_DTIL &kp OP_DIAE
               &trans    &kp OP_EURO  &kp OP_HASH  &kp OP_PERC    &kp OP_PLUS  &kp OP_SUP2      &kp OP_LBRC  &kp OP_LPRN &kp OP_RPRN &kp OP_RBRC &kp UP     &to_L3_from_L2
                                                     &to_L1_from_L2 &kp LALT &trans    &trans &trans &to_L4_from_L2
                >;
             };

        nav_layer {
            label = "NAVIG";
            // -----------------------------------------------------------------------------------------------------
            //                 |  F1  |  F2 |  F3 |  F4 |  F5 |  F6 |   |  PUP  |  HOME |  ↑  | END |  X  |  BSPC  |
            //                 |  F7  |  F8 |  F9 | F10 | F11 | F12 |   |  PDN  |   ←   |  ↓  |  →  |  X  |  ENTER |
            //                 | PREV | PLAY| NEXT| VDWN| MUTE| VUP |   |   X   |    X  |  X  |  X  |  x  |    X   |
            //                                    | L1  | ALT |  X  |   |   X   |    X  |  L2 |
            bindings = <
               &kp F1     &kp F2     &kp F3     &kp F4         &kp F5        &kp F6       &kp PG_UP   &kp HOME   &kp UP    &kp END   &trans &kp BSPC
               &kp F7     &kp F8     &kp F9     &kp F10        &kp F11       &kp F12      &kp PG_DN   &kp LEFT   &kp DOWN  &kp RIGHT &trans &kp ENTER
               &kp C_PREV &kp C_PP   &kp C_NEXT &kp C_VOL_DN   &kp C_MUTE    &kp C_VOL_UP &trans      &trans     &trans    &trans    &trans &none
                                              &to_L1_from_L3 &kp LALT &trans     &trans &trans &to_L2_from_L3
                     >;
                };
    };
};
